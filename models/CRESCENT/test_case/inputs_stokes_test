# Test case input file for Stokes wave simulation
#
# This configuration provides a deterministic test case with
# a Stokes wave initialization for precise comparison between
# Fortran and C++ implementations.

# Simulation time control
max_step = 2
stop_time = 2.0

# Domain configuration
amr.n_cell = 128 128 1
geometry.prob_extent = 200.0 200.0 10.0
geometry.is_periodic = 1 1 0
amr.max_level = 0

# HOS solver parameters
crescent.dt = 0.01
crescent.perturbation_order = 3
# NOTE: dk_x and dk_y are computed from domain geometry (2π/Lx, 2π/Ly), not specified in input

# Wave parameters - Stokes wave configuration
crescent.wave_type = stokes         # Use Stokes wave initialization
crescent.wave_mode_x = 5        # Number of waves in x direction
crescent.wave_steepness = 0.1          # Wave steepness
crescent.swell_wavenumber = 1.0
crescent.beta1_filter = 8.0    # Dealiasing filter parameters
crescent.beta2_filter = 12.0

# Output configuration
crescent.plot_file = "stokes_test"
crescent.plot_int = 5       # Write output every 5 steps

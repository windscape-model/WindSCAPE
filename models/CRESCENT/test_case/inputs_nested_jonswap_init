# Nested AMR JONSWAP Initialization Test
#
# Test multi-level Tecplot output with JONSWAP wave spectrum.
# Runs a single short step so initialization and first output complete.

# Simulation control
max_step = 1
stop_time = 0.02

# AMR configuration
amr.max_level = 1
amr.n_cell = 64 64 1
amr.ref_ratio_vect = 2 2 1
amr.regrid_on_restart = 0
amr.blocking_factor = 1
amr.regrid_int = 1000

# Domain configuration
geometry.prob_extent = 200.0 200.0 10.0
geometry.is_periodic = 1 1 0

# CRESCENT solver parameters
crescent.perturbation_order = 3
crescent.use_crescent_algorithm = 1
crescent.L1_box_lo = 50.0 50.0
crescent.L1_box_hi = 150.0 150.0
crescent.roi_accurate_fraction = 0.25
crescent.roi_spectral_fraction = 0.15

# Wave parameters - JONSWAP spectrum
crescent.wave_type = "jonswap"
crescent.wind_speed_10m = 12.0
crescent.fetch = 50000.0
crescent.wave_steepness = 0.08
crescent.initial_angle = 0.0
crescent.angle_spread = 0.5
crescent.beta1_filter = 8.0
crescent.beta2_filter = 12.0

crescent.use_c3_repair = 1
crescent.c3_use_interface = 1
crescent.c3_boundary_penalty = 0.01
crescent.c3_coefficient_regularization = 10.0

# Output configuration
crescent.plot_file = "nested_jonswap_init"
crescent.plot_int = 1
crescent.tecplot_int = 1
crescent.verbosity = 2

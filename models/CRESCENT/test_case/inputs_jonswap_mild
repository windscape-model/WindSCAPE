# JONSWAP Spectrum: Mild Sea Conditions
#
# Simulates light wind conditions with:
#   - Low wind speed (5 m/s ~ 10 knots light breeze)
#   - Moderate fetch (10 km)
#   - Low wave steepness
#
# Expected characteristics:
#   - Significant wave height: ~0.5-1 meter
#   - Peak period: ~3-4 seconds
#   - Gentle, nearly linear waves
#   - Good test for nearly linear regime

# Simulation time control
max_step = 200
stop_time = 20.0

# Domain configuration
amr.n_cell = 128 128 1
geometry.prob_extent = 200.0 200.0 10.0
geometry.is_periodic = 1 1 0
amr.max_level = 0

# HOS solver parameters
crescent.dt = 0.01
crescent.perturbation_order = 3             # Lower order sufficient for mild waves

# Wave parameters - Mild conditions
crescent.wave_type = jonswap          # JONSWAP spectrum
crescent.wind_speed_10m = 5.0           # 5 m/s light wind
crescent.fetch = 10000.0     # 10 km fetch
crescent.wave_steepness = 0.05          # Low steepness (nearly linear)
crescent.swell_wavenumber = 1.0
crescent.beta1_filter = 1.0
crescent.beta2_filter = 1.0
crescent.initial_angle = 0.0        # Mean wave direction
crescent.angle_spread = 1.5        # Moderate directional spreading

# Output configuration
crescent.plot_file = "jonswap_mild"
crescent.plot_int = 10

# JONSWAP Spectrum: Swell-Dominated Conditions
#
# Simulates swell conditions with:
#   - Moderate wind (12 m/s)
#   - Very large fetch (100 km - mature sea state)
#   - Narrow directional spreading (organized swell)
#
# Expected characteristics:
#   - Long-period waves (~8-10 seconds)
#   - Organized, quasi-monochromatic wave field
#   - Low steepness (smooth, rolling waves)
#   - Good test for directional spreading effects

# Simulation time control
max_step = 200
stop_time = 20.0

# Domain configuration
amr.n_cell = 128 128 1
geometry.prob_extent = 400.0 400.0 10.0   # Larger domain for long waves
geometry.is_periodic = 1 1 0
amr.max_level = 0

# HOS solver parameters
crescent.dt = 0.01
crescent.perturbation_order = 3

# Wave parameters - Swell conditions
crescent.wave_type = jonswap          # JONSWAP spectrum
crescent.wind_speed_10m = 12.0          # Moderate wind
crescent.fetch = 100000.0    # 100 km fetch (fully developed)
crescent.wave_steepness = 0.08          # Low steepness (smooth swell)
crescent.swell_wavenumber = 1.0
crescent.beta1_filter = 1.0
crescent.beta2_filter = 1.0
crescent.initial_angle = 0.0        # Mean wave direction
crescent.angle_spread = 0.5        # Narrow spreading (organized swell)

# Output configuration
crescent.plot_file = "jonswap_swell"
crescent.plot_int = 10

# Turbulent boundary layer over the ramped traveling wave (large-eddy simulation), M = 8
# with the wave drag at the surface

# Run length
max_step  = 3000000
stop_time = 60010

# Domain and mesh
amr.max_level             = 0
amr.n_cell                = 120 60 109
erf.grid_stretching_ratio = 1.0207
erf.initial_dz            = 0.5
fabarray.mfiter_tile_size = 1024000 1024000 1024000
geometry.is_periodic      = 1 1 0
geometry.prob_extent      = 300. 150. 200.
geometry.prob_lo          = 0.0 0.0 0.0

# Wave surface and initial state
erf.init_type            = Isentropic
erf.prob_name            = "Moving Terrain"
erf.terrain_smoothing    = 2
erf.terrain_type         = MovingFittedMesh
prob.Ampl                = 0.8
prob.T_0                 = 300.
prob.custom_terrain_type = "MovingSineWaveRamp"
prob.init_pert_amp       = 0.5
prob.init_ustar          = 0.3156
prob.init_z0             = 0.0002
prob.wavelength          = 50.0

# Boundaries
erf.most.wave_drag = 1
erf.most.z0        = 0.0002
erf.most.zref      = 0.25
zhi.type           = "SlipWall"
zlo.type           = "surface_layer"

# Physics
erf.Cs                     = 0.18
erf.abl_driver_type        = "PressureGradient"
erf.abl_pressure_grad      = -9.96e-4 0. 0.
erf.dryscal_horiz_adv_type = Centered_2nd
erf.dryscal_vert_adv_type  = Centered_2nd
erf.dycore_horiz_adv_type  = Centered_2nd
erf.dycore_vert_adv_type   = Centered_2nd
erf.les_type               = "Smagorinsky"
erf.molec_diff_type        = None
erf.rayleigh_damp_W        = 0
erf.use_gravity            = true

# Time integration
erf.beta_s             = 0.3
erf.fixed_dt           = 0.02
erf.fixed_mri_dt_ratio = 8
erf.substepping_type   = Implicit

# Output
amr.v              = 0
erf.check_file     = chk
erf.check_for_nans = 1
erf.check_int      = 50000
erf.data_log       = "surf" "mean" "flux" "subgrid"
erf.plot_file_1    = plt
erf.plot_int_1     = 2500
erf.plot_vars_1    = density x_velocity y_velocity z_velocity pressure theta pert_pres pert_dens detJ
erf.profile_int    = 2500
erf.sum_interval   = 1000
erf.v              = 0
